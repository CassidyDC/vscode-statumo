{
  "name": "statumo",
  "displayName": "Statumo",
  "description": "See Claude Code and Codex context use and rate limits in the VS Code status bar.",
  "version": "0.1.0",
  "publisher": "jacobcassidy",
  "license": "MIT",
  "author": {
    "name": "Jacob Cassidy",
    "email": "hello@jacobcassidy.com",
    "url": "https://jacobcassidy.com"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b1f2a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "rate limit",
    "status bar",
    "usage"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "type": "module",
  "main": "./src/extension.js",
  "files": [
    "src/",
    "claude-mod/",
    "images/icon.png",
    "images/statumo-hover.png",
    "images/statumo-icons.woff",
    "images/statumo-status-bar.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "statumo.refresh",
        "title": "Refresh Usage",
        "category": "Statumo"
      },
      {
        "command": "statumo.installClaudeMod",
        "title": "Install or Update the Usage Mod for Claude Code",
        "category": "Statumo"
      }
    ],
    "icons": {
