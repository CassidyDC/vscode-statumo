    "configuration": {
      "title": "Statumo",
      "properties": {
        "statumo.warningThreshold": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "Show an item with the warning background when any rate-limit window has this percent or less left."
        },
        "statumo.errorThreshold": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "Show an item with the error background when any rate-limit window has this percent or less left."
        },
        "statumo.timeFormat": {
          "type": "string",
          "enum": [
            "12h",
            "24h"
          ],
          "enumItemLabels": [
            "12-hour",
            "24-hour"
          ],
          "markdownEnumDescriptions": [
            "Show reset times on a 12-hour clock, such as `2:30 PM`.",
            "Show reset times on a 24-hour clock, such as `14:30`."
          ],
          "default": "12h",
          "markdownDescription": "The clock the tooltip shows each rate-limit window's reset time on."
        },
        "statumo.showTimeUntilReset": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show how long until each rate-limit window resets after its reset time in the tooltip, such as `(4h 30m)`."
        },
        "statumo.claude.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the Claude Code item."
        },
        "statumo.claude.configDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The Claude Code config folder the Usage mod writes to. Leave empty to use `CLAUDE_CONFIG_DIR`, or `~/.claude` when that isn't set."
        },
        "statumo.claude.clickCommand": {
          "type": "string",
          "default": "claude-vscode.focus",
          "markdownDescription": "The command to run when you click the Claude Code item. Leave empty to do nothing."
        },
        "statumo.codex.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the Codex item."
        },
        "statumo.codex.homeDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The Codex home folder. Leave empty to use `CODEX_HOME`, or `~/.codex` when that isn't set."
        },
        "statumo.codex.clickCommand": {
          "type": "string",
          "default": "chatgpt.openSidebar",
          "markdownDescription": "The command to run when you click the Codex item. Leave empty to do nothing."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "package": "vsce package --no-rewrite-relative-links --allow-missing-repository",
    "test": "node --test",
    "build:icons": "node scripts/build-icons.js",
    "install:local": "vsce package --no-rewrite-relative-links --allow-missing-repository --out statumo.vsix && code --install-extension statumo.vsix --force"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vscode/vsce": "^4.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.2",
    "globals": "^17.14.0",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "ttf2woff": "^3.0.0"
  }
}
